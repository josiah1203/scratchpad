{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://creative-platform.invalid/schemas/history-v1.schema.json",
  "title": "Unified Creative Platform snapshot and named-version metadata v1",
  "oneOf": [
    { "$ref": "#/$defs/snapshot" },
    { "$ref": "#/$defs/named_version" }
  ],
  "$defs": {
    "object_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "journal_cursor": {
      "type": "object",
      "required": ["lamport", "client_id", "client_sequence"],
      "additionalProperties": false,
      "properties": {
        "lamport": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
        "client_id": { "type": "string", "minLength": 1 },
        "client_sequence": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 }
      }
    },
    "snapshot": {
      "type": "object",
      "required": [
        "snapshot_id",
        "project_id",
        "snapshot_format_version",
        "graph_schema_version",
        "runtime_version",
        "cursor",
        "graph_json",
        "record_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "snapshot_id": { "$ref": "#/$defs/object_id" },
        "project_id": { "$ref": "#/$defs/object_id" },
        "snapshot_format_version": { "const": 1 },
        "graph_schema_version": { "type": "integer", "minimum": 1 },
        "runtime_version": { "type": "string", "minLength": 1 },
        "cursor": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/journal_cursor" }
          ]
        },
        "graph_json": { "type": "string", "minLength": 2 },
        "record_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "named_version": {
      "type": "object",
      "required": ["version_id", "project_id", "name", "snapshot_id"],
      "additionalProperties": false,
      "properties": {
        "version_id": { "$ref": "#/$defs/object_id" },
        "project_id": { "$ref": "#/$defs/object_id" },
        "name": { "type": "string", "minLength": 1 },
        "snapshot_id": { "$ref": "#/$defs/object_id" }
      }
    }
  }
}
